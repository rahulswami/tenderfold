<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to .env, vendor, storage/logs, git
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]

    # If the request is already pointing to /public, don't loop
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Allow direct access to deploy.php if present in root
    RewriteCond %{REQUEST_URI} ^/deploy\.php$ [NC]
    RewriteRule ^ - [L]

    # Forward all other requests to the /public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Fallback if mod_rewrite is unavailable
    RedirectMatch 302 ^/$ /public/
</IfModule>
