DirectoryIndex public/index.php index.php

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block unsafe HTTP methods
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F,L]

    # Block access to hidden/dot files and directories (except .well-known)
    RewriteRule ^\.(?!well-known) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]

    # Block direct access to internal application directories
    RewriteRule ^(app|bootstrap|config|database|mobile_app|node_modules|resources|routes|scratch|storage|tests|vendor|tender-fold)(/|$) - [F,L,NC]

    # Block direct access to sensitive root files, backups, dumps, and diagnostic scripts
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.(js|ts)|serve\.bat|deploy\.php|diagnose\.php|repair\.php)$ - [F,L,NC]
    RewriteRule \.(env|sql|sqlite|sqlite3|db|log|bak|old|orig|zip|tar|gz|sh|bat|md|yml|yaml|lock|ini)$ - [F,L,NC]
    RewriteRule ^[^/]+\.html$ - [F,L,NC]

    # Handle Root URL directly
    RewriteRule ^$ public/index.php [L]

    # Don't loop if already pointing to /public
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Forward existing static files/directories in /public
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route all other URLs to public/index.php
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    RedirectMatch 302 ^/$ /public/
</IfModule>
