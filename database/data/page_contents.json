    {
        "page": "home",
        "section": "about",
        "key": "body_p1",
        "value": "SumitZ Clinic is Pune's leading multidisciplinary healthcare center specializing in orthopaedic consultation, joint replacement, sports injury rehabilitation, and advanced physiotherapy. Led by Dr. Sumit, our team provides compassionate, evidence-based care tailored to each patient.",
        "created_at": "2026-07-07 11:09:47",
        "updated_at": "2026-08-24 11:10:46"
    },
    {
        "page": "home",
        "section": "about",
        "key": "body_p2",
        "value": "With state-of-the-art digital diagnostics, modern physiotherapy equipment, and two convenient clinics in Baner and Hinjewadi, we empower our patients to regain pain-free mobility and return to active living.",
        "created_at": "2026-07-07 11:09:47",
        "updated_at": "2026-08-24 11:10:46"
    },
